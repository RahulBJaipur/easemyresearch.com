          border-radius: 10px;    /* Slightly rounded rectangle */\n                    opacity: 1;\n                    background-color: #0077B6;\n                }\n\n                .carousel-indicators {\n                    bottom: 50px;\n                    left: auto;            /* Align to the left for big screens */\n                    right: 50px;           /* Reset right alignment */\n                    justify-content: flex-start; /* Align indicators to the left */\n                    padding: 15px;         /* Add padding from the left edge */\n                    margin: 0;             /* Remove default margins */\n                    margin-bottom: 29px !important\n                }\n\n                /* Media Queries for Mobile Responsiveness */\n                @media (max-width: 768px) {\n                    .carousel-indicators {\n                        left: 50%;         /* Center horizontally on mobile */\n                        transform: translateX(-50%); /* Center the indicators */\n                        right: auto;       /* Ensure no right alignment */\n                        bottom: 10px;      /* Keep bottom position */\n                        justify-content: center; /* Center the indicators */\n                        padding: 10px;     /* Reduce padding on smaller screens */\n                    }\n\n                    .carousel-indicators [data-bs-target] {\n                        width: 10px;       /* Smaller bubbles on mobile */\n                        height: 10px;\n                        margin: 0 4px;     /* Reduce spacing */\n                    }\n\n                    .carousel-indicators .active {\n                        width: 20px;       /* Smaller rectangle on mobile */\n                        height: 6px;\n                    }\n                }\n\n                @media (max-width: 576px) {\n                    .mt-5 {\n                        margin-top: 2rem !important; /* Reduce spacing on very small screens */\n                    }\n\n                    .px-3 {\n                        padding-left: 1rem !important; /* Reduce padding */\n                        padding-right: 1rem !important;\n                    }\n\n                    .py-4 {\n                        padding-top: 1.5rem !important; /* Reduce padding */\n                        padding-bottom: 1.5rem !important;\n                    }\n                }\n            "]],["SECTION",{"class":"py-5 d-flex justify-content-center"},["MAIN",{"class":"text-center feature-carousel-container container"},["BUTTON",{"class":"btn fw-semibold rounded-pill mb-3","style":"background-color: rgb(246, 246, 246); font-size: 16px; padding: 8px 40px;"},"Features"],["H3",{"class":"display-6 fw-bold text-dark mb-3 px-3","style":"font-size: 28px;"},"Everything you Need for"," ",["SPAN",{"class":"text-primary"},"Hassle-Free Research"]],["P",{"class":"text-muted mb-4 px-3","style":"font-size: 16px;"},"Effortlessly collect, secure, and analyse your research data - all in one place"],["DIV",{"class":"d-none d-md-block"},["DIV",{"class":"row justify-content-center g-3"},["DIV",{"class":"col-12 col-sm-6 col-md-4"},["DIV",{"class":"card p-3 shadow-lg d-flex align-items-center flex-row gap-2 feature-item"},["IMG",{"__playwright_current_src__":"data:image/svg+xml,%3csvg%20width='24'%20height='24'%20viewBox='0%200%2024%2024'%20fill='none'%20xmlns='http://www.w3.org/2000/svg'%3e%3ccircle%20cx='12'%20cy='12'%20r='12'%20fill='%233D2CA3'%20fill-opacity='0.08'/%3e%3cg%20clip-path='url(%23clip0_178_16125)'%3e%3cpath%20d='M4.61572%2014.105L6.46942%2013.7808L7.28461%2018.4411L5.43092%2018.7653L4.61572%2014.105Z'%20fill='%233D2CA3'/%3e%3cpath%20d='M8.01923%2017.4714C8.34174%2017.207%208.75447%2017.0784%209.17015%2017.1129L12.9935%2017.4017H13.0056C13.7312%2017.3969%2014.4371%2017.1645%2015.0237%2016.7375L19.3849%2012.4625C19.0357%2012.2157%2018.5661%2012.2275%2018.2298%2012.4916L18.2247%2012.4955L16.054%2014.1186C16.1083%2014.2476%201