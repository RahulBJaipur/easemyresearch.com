-width: 100%;\n          margin: 0 auto;\n          padding-bottom: 30px; /* Add space for indicators */\n        }\n\n        .carousel-control-prev,\n        .carousel-control-next {\n          width: 10%;\n          display: none;\n        }\n\n        .carousel-indicators {\n          bottom: 0;\n          margin-bottom: 5px;\n          display: flex;\n          justify-content: center;\n          align-items: center;\n          padding: 0;\n        }\n\n        .carousel-indicators [data-bs-target] {\n          background-color: #666;\n          width: 8px;\n          height: 8px;\n          border-radius: 50%;\n          margin: 0 4px; /* Spacing between dots */\n          border: none;\n        }\n\n        .carousel-indicators .active {\n          width: 30px; /* Wider for rectangle shape */\n          height: 8px; /* Shorter height for rectangle */\n          border-radius: 10px; /* Slightly rounded rectangle */\n          opacity: 1;\n          background-color: #0077b6;\n        }\n\n        @media (max-width: 767px) {\n          .feature-item {\n            max-width: 100%;\n            margin: 0 auto;\n          }\n        }\n      "]],["SECTION",{"class":"py-5 justify-content-center top-reasons-section"},["MAIN",{"class":"text-center feature-carousel-container container"},["DIV",{"class":"d-none d-md-block px-3"},["DIV",{"class":"row g-4"},["DIV",{"class":"col-12 col-lg-4"},["DIV",{"class":"mb-4 text-start pt-5"},["DIV",{"style":"height: 30px;"}],["H3",{"class":"h2 fw-semibold text-dark mb-3","style":"font-size: 28px;"},"Top 6 Reasons for Why to Choose"," ",["SPAN",{"class":"text-primary"},"EMR"]," for your Research?"],["P",{"class":"text-muted mb-4","style":"font-size: 16px;"},"We aim to help you collect research data seamlessly, keep it secure, and analyze it."],["DIV",{"class":"d-flex gap-2 mb-4"},["BUTTON",{"class":"btn fw-semibold px-4 py-2 rounded shadow-sm w-100","style":"border-color: rgb(0, 119, 182); color: rgb(0, 119, 182); font-size: 16px;"},"Try for free"],["BUTTON",{"class":"btn text-white fw-semibold px-4 py-2 rounded shadow-sm w-100","style":"background: rgb(0, 119, 182); font-size: 16px;"},"Choose your plan"]]],["DIV",{"class":"card p-4 rounded shadow-lg mt-lg-5 py-lg-5","style":"background-color: rgb(185, 233, 250);"},["DIV",{"style":"height: 80px;"}],["H4",{"class":"h5 fw-semibold text-dark mb-2 text-start"},"Advanced Analysis and Graphs"],["P",{"class":"text-muted text-start"},"Instantly generate insights with visual analytics. Make data-driven decisions with ease."],["IMG",{"__playwright_current_src__":"","src":"/assets/analysis-graphs-icon-B9HzLp6h.svg","alt":"Advanced Analysis and Graphs Icon","class":"img-fluid w-50 mx-auto mb-3 py-lg-5"}],["DIV",{"style":"height: 80px;"}]]],["DIV",{"class":"col-12 col-lg-4"},["DIV",{"class":"card p-4 rounded shadow-lg mb-4","style":"background-color: rgb(48, 50, 150);"},["H4",{"class":"h5 fw-semibold text-white mb-2 text-start"},"Effortless Data Collection"],["P",{"class":"text-white text-start"},"Streamline research with intuitive digital forms. Say goodbye to manual data entry and paper forms."],["IMG",{"__playwright_current_src__":"","src":"/assets/data-collection-icon-CO3Un2H_.svg","alt":"Effortless Data Collection Icon","class":"img-fluid w-50 mx-auto mb-3 mt-5"}]],["DIV",{"class":"card p-4 rounded shadow-lg mb-4","style":"background-color: rgb(204, 230, 191);"},["H4",{"class":"h5 fw-semibold text-dark mb-2 text-start"},"Secure Data Storage"],["P",{"class":"text-dark text-start"},"Protect your research with encrypted cloud storage. Access data anytime with complete peace of mind."],["IMG",{"__playwright_current_src__":"","src":"/assets/secure-storage-icon-eUJg_ybi.svg","alt":"Secure Data Storage Icon","class":"img-fluid w-50 mx-auto mb-3 mt-5"}]],["DIV",{"class":"card p-4 rounded shadow-lg mb-4","style":"background-color: rgb(185, 250, 237);"},["H4",{"class":"h5 fw-semibold text-dark mb-2 text-start"},"Accurate Results"],["P",{"class":"text-dark text-start"},"Reduce errors with automated data validation."],["IMG",{"__playwright_current_src__":"","src":"/assets/accurate-results-icon-Boa0D60T.svg","alt":"Accurate Results Icon","class":"img-fluid w-50 mx-auto mb-3 mt-5"}]]],["DIV",{"class":"col-12 col-lg-4 mt-lg-5"},["DIV",{"class":"card  p-4 rounded shadow-lg mb-4 mt-lg-5","style":"background-color: rgb(185, 233, 250);"},["DIV",{"style":"height: 80px;"}],["H4",{"class":"h5 fw-semibold text-dark mb-2 text-start"},"Collaborative Tools"],["P",{"class":"text-muted text-start"},"Work seamlessly with your research team. Share, edit, and review data in real time."],["IMG",{"__playwright_current_src__":"","src":"/assets/collaborative-tools-icon-BqcGioES.svg","alt":"Collaborative Tools Icon","class":"img-fluid w-50 mx-auto mb-3 mt-5"}],["DIV",{"style":"height: 80px;"}]],["DIV",{"class":"card  p-4 rounded shadow-lg mb-4 ","style":"background-color: rgb(204, 230, 191);"},["H4",{"class":"h5 fw-semibold text-dark mb-2 text-start"},"Efficient Form Creation"],["P",{"class":"text-muted text-start"},"Design structured research forms effortlessly. No manual efforts required – just drag, drop, and generate."],["IMG",{"__playwright_current_src__":"data:image/svg+xml,%3csvg%20width='34'%20height='40'%20viewBox='0%200%2034%2040'%20fill='none'%20xmlns='http://www.w3.org/2000/svg'%3e%3cpath%20d='M23.4512%201.44922C22.266%200.568797%2020.8392%200.0731171%2019.3634%200.0290604C15.0647%20-0.0753299%2010.7638%200.101592%206.48818%200.558692C3.63223%200.890687%200.894241%203.62868%200.563026%206.48384C-0.187675%2013.4917%20-0.187675%2026.502%200.563026%2033.5122C0.894241%2036.3682%203.63223%2039.1069%206.48818%2039.4381C13.4752%2040.1873%2020.5223%2040.1873%2027.5094%2039.4381C30.3645%2039.1069%2033.1033%2036.3682%2033.4345%2033.5122C33.9446%2028.7401%2034.1071%2021.1831%2033.9228%2014.6345C33.9228%2014.6252%2033.9228%2014.6166%2033.9228%2014.6072C33.9135%2013.195%2033.458%2011.8219%2032.6213%2010.6842C30.0385%207.16901%2026.9481%204.05677%2