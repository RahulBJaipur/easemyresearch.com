# EaseMyResearch.com Test Configuration

# Base URL for testing
BASE_URL=https://easemyresearch.com/

# Test environment
NODE_ENV=production

# Test user credentials
TEST_USER_EMAIL_1=testoneemr@gmail.com
TEST_USER_PASSWORD_1=12345678
TEST_USER_EMAIL_2=testtwoemr@gmail.com
TEST_USER_PASSWORD_2=12345678

# Browser configuration
HEADLESS=true
SLOW_MO=0

# Test execution settings
PARALLEL_WORKERS=4
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000

# Screenshot and video settings
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=retain-on-failure

# Reporting
REPORT_OPEN=never
REPORT_OUTPUT_DIR=playwright-report

# CI/CD settings
CI=false
GITHUB_ACTIONS=false

# Performance testing
PERFORMANCE_BUDGET_LOAD_TIME=5000
PERFORMANCE_BUDGET_FCP=2500
PERFORMANCE_BUDGET_LCP=4000

# Accessibility testing
A11Y_RULES=wcag2a,wcag2aa,wcag21aa
A11Y_TAGS=cat.semantics,cat.color,cat.keyboard,cat.forms

# Local development
START_LOCAL_SERVER=false
LOCAL_SERVER_PORT=3000

# Debug settings
DEBUG_MODE=false
VERBOSE_LOGGING=false